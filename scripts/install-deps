#!/usr/bin/env bash
set -e


# check OSTYPE
# -----------------------------
if [[ "$OSTYPE" == "darwin"* ]]; then
  OS="macos"
elif [ -f /etc/fedora-release ]; then
  OS="fedora"
elif [ -f /etc/debian_version ]; then
  OS="ubuntu"
fi

# --- Helper ---
# Ask the package manager, so packages without a command (headers, python modules) work too
check_and_ins() {
  local pkg=$1
  local installed=1
  case $OS in
  "fedora") rpm -q "$pkg" >/dev/null 2>&1 || installed=0 ;;
  "ubuntu") dpkg -s "$pkg" >/dev/null 2>&1 || installed=0 ;;
  "macos") brew list "$pkg" >/dev/null 2>&1 || installed=0 ;;
  esac

  if [[ $installed == 0 ]]; then
    echo "$pkg not installed, installing..."
    case $OS in
    "fedora") sudo dnf install -y "$pkg" ;;
    "ubuntu") sudo apt update && sudo apt install -y "$pkg" ;;
    "macos") brew install "$pkg" ;;
    esac
  else
    echo "$pkg ready to use"
  fi
}

# Python: any python3 on PATH will do, don't install a second one next to pyenv/system python
if ! command -v python3 >/dev/null 2>&1; then
  check_and_ins "python3"
else
  echo "python3 ready to use"
fi

# Native deps check
# -----------------------------
check_and_ins "cmake"
check_and_ins "entr"

case $OS in
"fedora")
  check_and_ins "ninja-build"
  check_and_ins "gcc-c++"
  check_and_ins "boost-devel"
  check_and_ins "python3-devel"
  check_and_ins "clang-tools-extra"
  # Qt xcb platform plugin (Qt >= 6.5)
  check_and_ins "xcb-util-cursor"
  ;;
"ubuntu")
  check_and_ins "ninja-build"
  check_and_ins "g++"
  check_and_ins "libboost-dev"
  check_and_ins "python3-dev"
  check_and_ins "python3-venv"
  check_and_ins "clang-format"
  # Qt xcb platform plugin (Qt >= 6.5)
  check_and_ins "libxcb-cursor0"
  ;;
"macos")
  if ! xcode-select -p >/dev/null 2>&1; then
    echo "Installing Xcode Command Line Tools..."
    xcode-select --install
  else
    echo "Xcode CLI tools ready"
  fi
  check_and_ins "ninja"
  check_and_ins "boost"
  check_and_ins "clang-format"
  ;;
esac

# venv check
# -----------------------------
if [ ! -d ".venv" ]; then
  echo "Creating venv..."
  python3 -m venv .venv
else
  echo "venv ready"
fi

source .venv/bin/activate

# dependencies
# -----------------------------
echo "Installing Python deps"
python -m pip install -e ".[dev]"

# hooks
# -----------------------------
echo "Installing git hooks"
HOOKS_PATH=$(git config --get core.hooksPath || true)
if [ -n "$HOOKS_PATH" ]; then
  echo "Skipping hooks install (core.hooksPath is set: $HOOKS_PATH)"
fi


