#!/usr/bin/env bash
set -e


# check OSTYPE
# -----------------------------
if [[ "$OSTYPE" == "darwin"* ]]; then
  OS="macos"
  PKG_CHECK="brew list"
  PKG_INSTALL="brew install"
elif [ -f /etc/fedora-release ]; then
  OS="fedora"
  # --whatprovides also finds names a package provides (python3.14 is python3 on Fedora 43)
  PKG_CHECK="rpm -q --whatprovides"
  PKG_INSTALL="sudo dnf install -y"
elif [ -f /etc/debian_version ]; then
  OS="ubuntu"
  PKG_CHECK="dpkg -s"
  PKG_INSTALL="sudo apt-get install -y"
  sudo apt-get update
else
  # Other systems install their own packages
  OS=""
  echo "Unsupported OS: system packages are not installed. Install these yourself:"
  echo "  python3.14 with its headers and venv, cmake, ninja, a C++20 compiler,"
  echo "  Boost >= 1.83, entr, clang-format"
fi

if [[ "$OS" == "macos" ]] && ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew not found, install it first: https://brew.sh"
  exit 1
fi

# --- Helper ---
# Ask the package manager, so packages without a command (headers, python modules) work too
check_and_ins() {
  local pkg=$1
  [ -n "$OS" ] || return 0
  if $PKG_CHECK "$pkg" >/dev/null 2>&1; then
    echo "$pkg ready to use"
  else
    echo "$pkg not installed, installing..."
    $PKG_INSTALL "$pkg"
  fi
}

# Python: the venv runs on python3.14. A system python3 that is already 3.14 is used as is,
# otherwise 3.14 is installed next to it; the system's default python3 is never changed
PY=python3.14
py_ok() { "$1" -c 'import sys; sys.exit(sys.version_info[:2] != (3, 14))' >/dev/null 2>&1; }

if ! py_ok "$PY"; then
  case $OS in
  "ubuntu")
    # Ubuntu releases without 3.14 get it from the deadsnakes PPA
    if ! apt-cache show python3.14 >/dev/null 2>&1; then
      check_and_ins "software-properties-common"
      sudo add-apt-repository -y ppa:deadsnakes/ppa
    fi
    check_and_ins "python3.14"
    ;;
  "macos") check_and_ins "python@3.14" ;;
  *) check_and_ins "python3.14" ;;
  esac
  hash -r
  if ! py_ok "$PY"; then
    echo "$PY is required and was not found"
    exit 1
  fi
fi
echo "$PY ready to use"

# Native deps check
# -----------------------------
check_and_ins "cmake"
check_and_ins "entr"

case $OS in
"fedora")
  check_and_ins "ninja-build"
  check_and_ins "gcc-c++"
  check_and_ins "boost-devel"
  check_and_ins "python3.14-devel"
  check_and_ins "clang-tools-extra"
  # Qt xcb platform plugin (Qt >= 6.5)
  check_and_ins "xcb-util-cursor"
  ;;
"ubuntu")
  check_and_ins "ninja-build"
  check_and_ins "g++"
  check_and_ins "libboost-dev"
  check_and_ins "python3.14-dev"
  check_and_ins "python3.14-venv"
  check_and_ins "clang-format"
  # Qt xcb platform plugin (Qt >= 6.5)
  check_and_ins "libxcb-cursor0"
  ;;
"macos")
  if ! xcode-select -p >/dev/null 2>&1; then
    echo "Installing Xcode Command Line Tools..."
    xcode-select --install
  else
    echo "Xcode CLI tools ready"
  fi
  check_and_ins "ninja"
  check_and_ins "boost"
  check_and_ins "clang-format"
  ;;
esac

# venv check
# -----------------------------
# A venv made by another python (the old python3 one) is made again with python3.14
if [ -d ".venv" ] && ! py_ok .venv/bin/python; then
  echo "venv is not on Python 3.14, recreating..."
  rm -rf .venv
fi
if [ ! -d ".venv" ]; then
  echo "Creating venv..."
  "$PY" -m venv .venv
else
  echo "venv ready"
fi

source .venv/bin/activate

# dependencies
# -----------------------------
echo "Installing Python deps"
python -m pip install -e ".[dev]"

# hooks
# -----------------------------
echo "Installing git hooks"
HOOKS_PATH=$(git config --get core.hooksPath || true)
if [ -n "$HOOKS_PATH" ]; then
  echo "Skipping hooks install (core.hooksPath is set: $HOOKS_PATH)"
fi


