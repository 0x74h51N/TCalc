#!/usr/bin/env bash
set -e

echo "== Calculator Dev Mode (auto-restart) =="

# check OSTYPE
# -----------------------------
if [[ "$OSTYPE" == "darwin"* ]]; then
  OS="macos"
elif [ -f /etc/fedora-release ]; then
  OS="fedora"
elif [ -f /etc/debian_version ]; then
  OS="ubuntu"
fi

# --- Helper ---
check_and_ins() {
  local cmd=$1
  local pkg=$2
  [[ -z "$pkg" ]] && pkg=$cmd

  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "$cmd not installed, installing $pkg..."
    case $OS in
    "fedora") sudo dnf install -y "$pkg" ;;
    "ubuntu") sudo apt update && sudo apt install -y "$pkg" ;;
    "macos") brew install "$pkg" ;;
    esac
  else
    echo "$cmd ready to use"
  fi
}

# Native deps check
# -----------------------------

check_and_ins "cmake"
check_and_ins "ninja"

if [[ "$OS" == "fedora" ]]; then
  check_and_ins "g++" "gcc-c++"
elif [[ "$OS" == "ubuntu" ]]; then
  check_and_ins "g++" "g++"
elif [[ "$OS" == "macos" ]]; then
  if ! xcode-select -p >/dev/null 2>&1; then
    echo "Installing Xcode Command Line Tools..."
    xcode-select --install
  else
    echo "Xcode CLI tools ready"
  fi
fi

# Boost headers
if [[ "$OS" == "fedora" ]]; then
  check_and_ins "boost" "boost-devel"
elif [[ "$OS" == "ubuntu" ]]; then
  check_and_ins "boost" "libboost-dev"
elif [[ "$OS" == "macos" ]]; then
  check_and_ins "boost"
fi

check_and_ins "entr"

# Python + devel check
# -----------------------------
check_and_ins "python3" "python3"
if [[ "$OS" == "fedora" ]]; then
  check_and_ins "python3-config" "python3-devel"
elif [[ "$OS" == "ubuntu" ]]; then
  check_and_ins "python3-config" "python3-dev"
fi

# venv check
# -----------------------------
if [ ! -d ".venv" ]; then
  echo "Creating venv..."
  python3 -m venv .venv
else
  echo "venv ready"
fi

source .venv/bin/activate

# dependencies
# -----------------------------
echo "Installing Python deps"
python -m pip install -e ".[dev]"

# hooks
# -----------------------------
echo "Installing git hooks"
HOOKS_PATH=$(git config --get core.hooksPath || true)
if [ -n "$HOOKS_PATH" ]; then
  echo "Skipping hooks install (core.hooksPath is set: $HOOKS_PATH)"
else
  make hooks
fi

# native build + tests (CMake + Ninja)
# -----------------------------
make native-test NATIVE_TEST_ARGS=""

# generate Python stubs for dynamic ops enum
# -----------------------------
echo "Generating ops stubs"
python scripts/stubgen/main.py

echo "Auto-restart enabled"

# Hot reload
# -----------------------------
find src -name "*.py" | entr -r python -m tcalc --debug
