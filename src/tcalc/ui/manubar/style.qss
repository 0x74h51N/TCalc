QMenu {
    background: $menu_panel_background_color;
    color: $menu_panel_text_color;
    border: 1px solid $menu_panel_border_color;
    padding: ${menu_panel_padding_y}px ${menu_panel_padding_x}px;
    font-size: ${menu_panel_text_font_min_pt}px;
}

QMenu::item {
    padding: ${menu_item_padding_y}px ${menu_item_padding_x}px;
    border-radius: ${menu_item_radius}px;
    border: 1px solid transparent;
    margin: ${menu_item_margin}px 0;
    min-width: ${menu_item_min_width}px;
}

QMenu::item:selected,
QMenu::item:checked {
    background: $menu_item_checked_color;
    color: $menu_item_checked_text_color;
    border: 1px solid $menu_selected_border_color;
}

QMenu::item:disabled {
    color: $menu_item_disabled_text_color;
}

QMenu::icon {
    padding-left: ${menu_icon_padding_left}px;
    padding-right: ${menu_icon_padding_right}px;
}

QMenu::separator {
    height: ${menu_separator_height}px;
    background: $menu_panel_separator_color;
    margin: ${menu_separator_margin_y}px ${menu_separator_margin_x}px;
}
