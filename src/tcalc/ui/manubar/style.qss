QMenu {
    background: $background_medium;
    color: $text_primary;
    border: 1px solid $border_light;
    padding: ${menu_padding}px;
    font-size: ${menu_font_size}px;
}

/* Native items and the custom-preset row (a QWidgetAction QPushButton that
   can't inherit QMenu::item) share one look. */
QMenu::item,
QPushButton[presetRow="true"] {
    padding: ${item_padding_vertical}px ${item_padding_horizontal}px;
    border-radius: ${item_border_radius}px;
    border: 1px solid transparent;
}

QMenu::item {
    margin: ${item_margin}px 0;
    min-width: ${item_min_width}px;
}

QPushButton[presetRow="true"] {
    background: transparent;
    color: $text_primary;
    text-align: left;
}

QMenu::item:selected,
QMenu::item:checked,
QPushButton[presetRow="true"]:hover,
QPushButton[presetRow="true"][active="true"] {
    background: $selection_background;
    color: $selection_text;
    border: 1px solid $border_focus;
}

QMenu::item:disabled {
    color: $text_secondary;
}

QMenu::icon {
    padding-left: ${icon_padding_left}px;
    padding-right: ${icon_padding_right}px;
}

QMenu::separator {
    height: ${separator_height}px;
    background: $border_light;
    margin: ${separator_margin_vertical}px ${separator_margin_horizontal}px;
}
