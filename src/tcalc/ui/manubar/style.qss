QMenu {
    background: $menu_background_color;
    color: $menu_text_color;
    border: 1px solid $menu_border_color;
    padding: ${menu_padding}px;
    font-size: ${menu_font_size}px;
}

QMenu::item {
    padding: ${menu_item_padding_vertical}px ${menu_item_padding_horizontal}px;
    border-radius: ${menu_item_border_radius}px;
    border: 1px solid transparent;
    margin: ${menu_item_margin}px 0;
    min-width: ${menu_item_min_width}px;
}

QMenu::item:selected,
QMenu::item:checked {
    background: $menu_selected_color;
    color: $menu_selected_text_color;
    border: 1px solid $menu_selected_border_color;
}

QMenu::item:disabled {
    color: $menu_disabled_text_color;
}

QMenu::icon {
    padding-left: ${menu_icon_padding_left}px;
    padding-right: ${menu_icon_padding_right}px;
}

QMenu::separator {
    height: ${menu_separator_height}px;
    background: $menu_separator_color;
    margin: ${menu_separator_margin_vertical}px ${menu_separator_margin_horizontal}px;
}
