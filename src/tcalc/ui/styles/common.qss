QToolTip {
    background-color: $tooltip_background_color;
    border: 1px solid $tooltip_border_color;
    border-radius: ${tooltip_radius}px;
    color: $tooltip_text_color;
    padding: ${tooltip_padding}px;
}

QPushButton[uiRole="iconButton"] {
    background-color: $icon_button_color;
    color: $icon_button_text_color;
    border: 1px solid $icon_button_shadow_color;
    border-top-color: $icon_button_light_color;
    border-left-color: $icon_button_light_color;
    border-radius: ${icon_button_radius}px;
    padding: ${icon_padding}px;
}

QPushButton[uiRole="iconButton"]:hover {
    background-color: $icon_button_hover_color;
}

QPushButton[uiRole="iconButton"]:pressed {
    background-color: $icon_button_pressed_color;
    border-top-color: $icon_button_shadow_color;
    border-left-color: $icon_button_shadow_color;
    border-bottom-color: $icon_button_light_color;
    border-right-color: $icon_button_light_color;
}

QPushButton[uiRole="toolbarToggle"] {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

QRadioButton[optionRole="option"] {
    background-color: transparent;
    color: $option_text_color;
    border-radius: ${option_radius}px;
    padding: ${option_padding_y}px ${option_padding_x}px;
    spacing: 0px;
}

QRadioButton[optionRole="option"]::indicator {
    width: 0px;
    height: 0px;
}

QRadioButton[optionRole="option"]:hover {
    background-color: $option_hover_color;
}

QRadioButton[optionRole="option"]:checked {
    background-color: $option_checked_color;
    color: $option_checked_text_color;
}
