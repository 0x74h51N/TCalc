QToolTip {
    background-color: $tooltip_background_color;
    border: 1px solid $tooltip_border_color;
    border-radius: ${tooltip_radius}px;
    color: $tooltip_text_color;
    padding: ${tooltip_padding_y}px ${tooltip_padding_x}px;
}

QLabel#dockTitle {
    color: $dock_color;
    font-size: ${dock_font_min_pt}pt;
}

QTabBar::tab {
    color: $tabs_color;
    font-size: ${tabs_font_min_pt}pt;
}

/* An icon button without a look of its own */
QPushButton[uiRole="iconButton"] {
    background-color: $icon_button_color;
    color: $icon_button_text_color;
    border: ${icon_button_edge_width}px solid $icon_button_edge_shadow_color;
    border-top-color: $icon_button_edge_light_color;
    border-left-color: $icon_button_edge_light_color;
    border-radius: ${icon_button_radius}px;
    padding: ${icon_button_padding_y}px ${icon_button_padding_x}px;
}

QPushButton[uiRole="iconButton"]:hover {
    background-color: $icon_button_hover_color;
}

QPushButton[uiRole="iconButton"]:pressed {
    background-color: $icon_button_pressed_color;
    border-top-color: $icon_button_edge_shadow_color;
    border-left-color: $icon_button_edge_shadow_color;
    border-bottom-color: $icon_button_edge_light_color;
    border-right-color: $icon_button_edge_light_color;
}

QPushButton[uiRole="toolbarToggle"] {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

QRadioButton[optionRole="option"] {
    background-color: $options_color;
    color: $options_text_color;
    padding: ${options_padding_y}px ${options_padding_x}px;
    spacing: 0px;
    font-size: ${options_text_font_min_pt}pt;
}

QRadioButton[optionRole="option"]::indicator {
    width: 0px;
    height: 0px;
}

QRadioButton[optionRole="option"]:hover {
    background-color: $options_hover_color;
}

QRadioButton[optionRole="option"]:pressed {
    background-color: $options_pressed_color;
}

QRadioButton[optionRole="option"]:checked {
    background-color: $options_checked_color;
    color: $options_checked_text_color;
}

/* A border, even 0 px, drops the style's own button frame: edges only where a theme asks */
QWidget[raised="true"] QRadioButton[optionRole="option"] {
    border: ${options_edge_width}px solid $options_edge_shadow_color;
    border-top-color: $options_edge_light_color;
    border-left-color: $options_edge_light_color;
}

QWidget[raised="true"] QRadioButton[optionRole="option"]:checked {
    border-top-color: $options_edge_shadow_color;
    border-left-color: $options_edge_shadow_color;
    border-bottom-color: $options_edge_light_color;
    border-right-color: $options_edge_light_color;
}
