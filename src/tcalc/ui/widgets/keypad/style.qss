QPushButton[keypadRole] {
    background-color: $secondary;
    color: $secondary_text;
    border-radius: ${radius_small}px;
    padding: ${button_padding}px;
}
QPushButton[keypadRole]:hover {
    border: 1px solid $accent_text;
}
QPushButton[keypadRole]:pressed, QPushButton[keypadRole][pressed="true"] {
    background-color: $secondary_hover;
}
QPushButton[keypadRole]:disabled {
    background-color: $disabled_bg;
    color: $disabled_text;
    border-color: $disabled_bg;
}
QPushButton[keypadRole]:checked {
    background-color: $action_hover;
}

QPushButton[keypadRole="operator"] {
    background-color: $accent;
    color: $accent_text;
}
QPushButton[keypadRole="operator"]:hover {
    border: 1px solid $accent_text;
}
QPushButton[keypadRole="operator"]:pressed, QPushButton[keypadRole="operator"][pressed="true"] {
    background-color: $accent_hover;
}

QPushButton[keypadRole="action"] {
    background-color: $action;
    color: $action_text;
}
QPushButton[keypadRole="action"]:hover {
    border: 1px solid $accent_text;
}
QPushButton[keypadRole="action"]:pressed, QPushButton[keypadRole="action"][pressed="true"] {
    background-color: $action_hover;
}

QPushButton[keypadRole="equals"] {
    background-color: $primary;
    color: $primary_text;
    border-color: $border_focus;
}
QPushButton[keypadRole="equals"]:hover {
    border: 1px solid $accent_text;
}
QPushButton[keypadRole="equals"]:pressed, QPushButton[keypadRole="equals"][pressed="true"] {
    background-color: $primary_hover;
}

QPushButton[keypadRole="trig"] {
    background-color: $action;
    color: $action_text;
}
QPushButton[keypadRole="trig"]:hover {
    border: 1px solid $accent_text;
}
QPushButton[keypadRole="trig"]:pressed, QPushButton[keypadRole="trig"][pressed="true"] {
    background-color: $action_hover;
}

QPushButton[keypadRole="function"] {
    background-color: $accent;
    color: $accent_text;
}
QPushButton[keypadRole="function"]:hover {
    border: 1px solid $accent_text;
}
QPushButton[keypadRole="function"]:pressed, QPushButton[keypadRole="function"][pressed="true"] {
    background-color: $accent_hover;
}

QPushButton[keypadRole="power"] {
    background-color: $secondary;
    color: $secondary_text;
}
QPushButton[keypadRole="power"]:hover {
    border: 1px solid $accent_text;
}
QPushButton[keypadRole="power"]:pressed, QPushButton[keypadRole="power"][pressed="true"] {
    background-color: $secondary_hover;
}

QPushButton[keypadRole="trig"],
QPushButton[keypadRole="function"],
QPushButton[keypadRole="power"] {
    padding: ${compact_pad_y}px ${compact_pad_x}px;
}

/* Custom pad toolbar */
QSpinBox[customPadToolbar="true"] {
    background-color: $custom_spin_bg;
    color: $custom_spin_text;
    border: 1px solid $custom_spin_border;
    border-radius: ${radius_small}px;
    padding: 1px 2px;
}

/* Custom pad context menu */
QMenu[customPadMenu="true"] {
    background-color: $custom_context_menu_bg;
    color: $custom_context_menu_text;
    border: 1px solid $custom_picker_border;
}
QMenu[customPadMenu="true"]::item:selected {
    background-color: $custom_context_menu_hover;
}
/* Searchable picker popup */
SearchablePicker {
    background-color: $custom_picker_bg;
    border: 1px solid $custom_picker_border;
}
SearchablePicker QLineEdit {
    background-color: $custom_picker_search_bg;
    color: $custom_picker_search_text;
    border: 1px solid $custom_picker_border;
    padding: 2px 4px;
}
SearchablePicker QListView {
    background-color: $custom_picker_list_bg;
    color: $custom_picker_list_text;
    border: none;
}
SearchablePicker QListView::item:hover {
    background-color: $custom_picker_list_hover;
}

QMenu[customPadMenu="true"]::separator {
    background-color: $accent;
}

QPushButton[addButton="true"] {
    background-color: $accent;
}

QPushButton[addButton="true"]::hover {
    background-color: $secondary_hover;
}
