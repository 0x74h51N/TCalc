QWidget[uiRole="keypad"] QPushButton[keypadRole] {
    background-color: $keypad_number_color;
    color: $keypad_number_text_color;
    padding: ${keypad_button_padding}px;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole]:hover {
    border: 1px solid $keypad_hover_border_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole]:pressed,
QWidget[uiRole="keypad"] QPushButton[keypadRole][pressed="true"] {
    background-color: $keypad_number_pressed_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole]:disabled {
    background-color: $keypad_disabled_color;
    color: $keypad_disabled_text_color;
    border-color: $keypad_disabled_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole]:checked {
    background-color: $keypad_checked_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="operator"] {
    background-color: $keypad_operator_color;
    color: $keypad_operator_text_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="operator"]:pressed,
QWidget[uiRole="keypad"] QPushButton[keypadRole="operator"][pressed="true"] {
    background-color: $keypad_operator_pressed_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="action"] {
    background-color: $keypad_action_color;
    color: $keypad_action_text_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="action"]:pressed,
QWidget[uiRole="keypad"] QPushButton[keypadRole="action"][pressed="true"] {
    background-color: $keypad_action_pressed_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="trig"] {
    background-color: $keypad_trig_color;
    color: $keypad_trig_text_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="trig"]:pressed,
QWidget[uiRole="keypad"] QPushButton[keypadRole="trig"][pressed="true"] {
    background-color: $keypad_trig_pressed_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="function"] {
    background-color: $keypad_function_color;
    color: $keypad_function_text_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="function"]:pressed,
QWidget[uiRole="keypad"] QPushButton[keypadRole="function"][pressed="true"] {
    background-color: $keypad_function_pressed_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="power"] {
    background-color: $keypad_power_color;
    color: $keypad_power_text_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="power"]:pressed,
QWidget[uiRole="keypad"] QPushButton[keypadRole="power"][pressed="true"] {
    background-color: $keypad_power_pressed_color;
}

QWidget[uiRole="keypad"] QPushButton[keypadRole="trig"],
QWidget[uiRole="keypad"] QPushButton[keypadRole="function"],
QWidget[uiRole="keypad"] QPushButton[keypadRole="power"] {
    padding: ${keypad_compact_pad_y}px ${keypad_compact_pad_x}px;
}

/* A border, even 0 px, drops the style's own button frame: edges only where a theme asks */
QWidget[uiRole="keypad"][raised="true"] QPushButton[keypadRole] {
    border: ${keypad_edge_width}px solid $keypad_edge_shadow_color;
    border-top-color: $keypad_edge_light_color;
    border-left-color: $keypad_edge_light_color;
}

QWidget[uiRole="keypad"][raised="true"] QPushButton[keypadRole]:pressed,
QWidget[uiRole="keypad"][raised="true"] QPushButton[keypadRole][pressed="true"],
QWidget[uiRole="keypad"][raised="true"] QPushButton[keypadRole]:checked {
    border-top-color: $keypad_edge_shadow_color;
    border-left-color: $keypad_edge_shadow_color;
    border-bottom-color: $keypad_edge_light_color;
    border-right-color: $keypad_edge_light_color;
}

/* Custom pad toolbar */
KSSpinBox {
    background-color: $custom_pad_spinbox_color;
    color: $custom_pad_spinbox_text_color;
    /* Not themed: the spin boxes keep one look so their fixed width fits */
    border-radius: 2px;
    padding: 1px 2px;
}

KSSpinBox:hover,
KSSpinBox:focus {
    border: 1px solid $custom_pad_spinbox_focus_border_color;
}

/* Custom pad context menu */
QMenu[customPadMenu="true"] {
    background-color: $custom_pad_menu_background_color;
    color: $custom_pad_menu_text_color;
    border: 1px solid $custom_pad_menu_border_color;
}

QMenu[customPadMenu="true"]::item:selected {
    background-color: $custom_pad_menu_selected_color;
}

/* Searchable picker popup */
SearchablePicker {
    background-color: $picker_background_color;
    border: 1px solid $picker_border_color;
}

SearchablePicker QLineEdit {
    background-color: $picker_list_background_color;
    color: $picker_text_color;
    font-size: ${picker_font_size}pt;
    border: 1px solid $picker_border_color;
    padding: 2px 4px;
}

SearchablePicker QListView {
    background-color: $picker_list_background_color;
    color: $picker_text_color;
    font-size: ${picker_font_size}pt;
    border: none;
}

SearchablePicker QListView::item:hover {
    background-color: $picker_hover_color;
}

QMenu[customPadMenu="true"]::separator {
    background-color: $custom_pad_menu_separator_color;
}

QFrame#toolbarSeparator {
    color: $custom_pad_toolbar_separator_color;
}

QPushButton[addButton="true"] {
    background-color: $custom_pad_add_key_color;
}

QPushButton[addButton="true"]:hover {
    background-color: $custom_pad_add_key_hover_color;
}
