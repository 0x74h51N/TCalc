/* Display */
QLineEdit[exprInput="true"] {
    border: none;
    background-color: transparent;
    color: $display_expression_text_color;
    selection-background-color: $display_expression_selection_color;
    selection-color: $display_expression_selection_text_color;
}

QWidget[exprSlot="true"][exprSlotKind="aux"] {
    background-color: transparent;
    font-size: bold;
}

QWidget[exprSlot="true"][exprSlotKind="aux"] QLineEdit[LatexKind="aux"]:focus,
QWidget[exprSlot="true"][exprSlotKind="script"] QLineEdit[LatexKind="script"]:focus {
    background-color: $display_expression_slot_focus_color;
}

QWidget#radicandSlot, QWidget#radicandSlot:focus {
    border-top: ${display_root_border_width}px solid $display_radical_line_color;
}

/* The calculator screen: the theme's screen brush on the whole display, its parts see through */
QWidget#displayWidget {
    background: $display_background_color;
}

QScrollArea#displayExpression,
QScrollArea#displayExpression QWidget#qt_scrollarea_viewport,
QWidget#displayExpressionEditor,
Result {
    background: transparent;
}
QFrame#displayDivider {
    min-height: ${display_divider_height}px;
    max-height: ${display_divider_height}px;
}

