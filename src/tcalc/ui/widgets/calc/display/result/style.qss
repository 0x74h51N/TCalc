QLabel#displayResult {
    color: $result_text_color;
}

QPushButton#fracToggleBtn {
    background-color: $result_fraction_button_color;
    border: none;
}
QPushButton#fracToggleBtn:hover {
    background-color: $result_fraction_button_hover_color;
}
QPushButton#fracToggleBtn:pressed {
    background-color: $result_fraction_button_pressed_color;
}

QLabel#statusLabel {
    color: $display_status_text_color;
    font-style: italic;
}
QLabel#statusLabel[statusKind="error"] {
    color: $display_status_error_text_color;
}
