QLabel#displayResult {
    color: $text_primary;
}

QPushButton#fracToggleBtn {
    background-color: $control_bg;
    border: none;
    border-radius: ${btn_radius}px;
}
QPushButton#fracToggleBtn:hover {
    background-color: $control_bg_hover;
}
QPushButton#fracToggleBtn:pressed {
    background-color: $control_bg_pressed;
}

QLabel#statusLabel {
    color: $text_secondary;
    font-style: italic;
}
QLabel#statusLabel[statusKind="error"] {
    color: $status_error;
}
