QPushButton[keypadRole="memory"] {
    background-color: $control_bg;
    color: $control_accent;
    border: none;
    padding: ${memory_pad_y}px ${memory_pad_x}px;
}
QPushButton[keypadRole="memory"]:hover {
    background-color: $control_bg_hover;
}
QPushButton[keypadRole="memory"]:pressed, QPushButton[keypadRole="memory"][pressed="true"] {
    background-color: $control_bg_pressed;
}
QPushButton[keypadRole="memory"]:disabled {
    background-color: $control_disabled_bg;
    color: $control_disabled_text;
}
